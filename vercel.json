{
  "buildCommand": "cd app/app && npm install && npm run build",
  "outputDirectory": "app/app/dist/public",
  "installCommand": "cd app/app && npm install",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://reciept-ai-software.onrender.com/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
