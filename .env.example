###############################################################################
# Receipt AI — Production Environment Configuration
# Copy to .env and fill in all values marked <CHANGE_ME>
###############################################################################

# ─── Application ──────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=<CHANGE_ME_random_64_chars>
ENCRYPTION_KEY=<CHANGE_ME_random_64_chars>
CORS_ORIGINS=https://app.receiptai.com
INSTANCE_ID=prod-1

# ─── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://receipt_ai:<DB_PASSWORD>@postgres:5432/receipt_ai
DATABASE_READ_URL=    # Optional read replica: postgresql://user:pass@replica:5432/receipt_ai

# ─── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=300

# ─── S3 / Object Storage ─────────────────────────────────────────────────
S3_ENDPOINT=                                    # https://s3.amazonaws.com
S3_ACCESS_KEY=<CHANGE_ME>
S3_SECRET_KEY=<CHANGE_ME>
S3_BUCKET=receipt-ai-prod
S3_REGION=us-east-1
S3_PUBLIC_URL=                                  # CDN URL: https://cdn.receiptai.com
LOCAL_STORAGE_DIR=./storage

# ─── Email (SMTP) ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=<CHANGE_ME>
SMTP_PASSWORD=<CHANGE_ME>
SMTP_FROM=noreply@receiptai.com
SMTP_USE_TLS=true
CLIENT_PORTAL_SECRET=<CHANGE_ME>
VENDOR_PORTAL_SECRET=<CHANGE_ME>

# ─── Payments (Stripe) ───────────────────────────────────────────────────
STRIPE_API_KEY=<CHANGE_ME>
STRIPE_WEBHOOK_SECRET=<CHANGE_ME>

# ─── AI / LLM ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=<CHANGE_ME>
ANTHROPIC_API_KEY=<CHANGE_ME>

# ─── Rate Limiting ───────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_DEFAULT=1000/minute

# ─── Security ─────────────────────────────────────────────────────────────
HTTPS_REDIRECT=true
ACCESS_TOKEN_EXPIRE_DAYS=30
CSP_DEFAULT_SRC="'self'"
HSTS_MAX_AGE=31536000

# ─── Background Tasks (Celery) ───────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── OpenTelemetry (optional) ─────────────────────────────────────────────
OTEL_SERVICE_NAME=receipt-ai
OTEL_EXPORTER_OTLP_ENDPOINT=                   # https://api. honeycomb.io:443

# ─── Backup ───────────────────────────────────────────────────────────────
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30